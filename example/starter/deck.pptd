version: v2
title: "PPTD Starter Template"
size: [960, 540]
theme:
  colors:
    ink: "#1E293B"
    muted: "#64748B"
    paper: "#F8FAFC"
    primary: "#2563EB"
    accent: "#0EA5E9"
    surface: "#FFFFFF"
    cardBg: "#EFF6FF"
    border: "#E2E8F0"
  textStyles:
    title:
      fontFamily: "思源宋体"
      fontSize: 26
      bold: true
      color: "$ink"
    subtitle:
      fontFamily: "思源黑体"
      fontSize: 14
      color: "$muted"
    body:
      fontFamily: "思源黑体"
      fontSize: 13
      lineHeight: 1.5
      color: "$ink"
    footer:
      fontFamily: "思源黑体"
      fontSize: 11
      color: "$muted"
pages:
  - pages/01_starter.page
